<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <Scene backgroundColor="#ff000000">
        <!-- 4 Radial Framework Tracks around the circular display -->
        <Group x="0" y="0" width="450" height="450" name="radial_framework" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <PartDraw x="0" y="0" width="450" height="450">
                <!-- Top-Right Radial Track (Battery: 16° to 76°) -->
                <Arc direction="CLOCKWISE" startAngle="16" endAngle="76" centerX="225" centerY="225" width="416" height="416">
                    <Stroke color="#359ece6a" cap="ROUND" thickness="10"/>
                </Arc>
                <!-- Bottom-Right Radial Track (Steps: 104° to 164°) -->
                <Arc direction="CLOCKWISE" startAngle="104" endAngle="164" centerX="225" centerY="225" width="416" height="416">
                    <Stroke color="#35e0af68" cap="ROUND" thickness="10"/>
                </Arc>
                <!-- Bottom-Left Radial Track (Heart/Health: 196° to 256°) -->
                <Arc direction="CLOCKWISE" startAngle="196" endAngle="256" centerX="225" centerY="225" width="416" height="416">
                    <Stroke color="#35f7768e" cap="ROUND" thickness="10"/>
                </Arc>
                <!-- Top-Left Radial Track (Weather/Events: 284° to 344°) -->
                <Arc direction="CLOCKWISE" startAngle="284" endAngle="344" centerX="225" centerY="225" width="416" height="416">
                    <Stroke color="#357dcfff" cap="ROUND" thickness="10"/>
                </Arc>
            </PartDraw>
        </Group>

        <!-- Omarchy Green Arch Icon (1.3x larger: 74x74) -->
        <PartImage x="188" y="80" width="74" height="74" alpha="255">
            <Image resource="ic_omarchy_icon"/>
            <Variant mode="AMBIENT" target="alpha" value="80"/>
        </PartImage>

        <!-- Official Omarchy Pixel Art Wordmark (1.3x larger: 234x55) -->
        <PartImage x="108" y="160" width="234" height="55" alpha="255">
            <Image resource="ic_omarchy_logo_white"/>
            <Variant mode="AMBIENT" target="alpha" value="130"/>
        </PartImage>

        <!-- Digital Clock (Interactive Mode) -->
        <DigitalClock x="25" y="222" width="400" height="75">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="400" height="75" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <Font family="jetbrains_mono_bold" size="62" weight="BOLD" color="#ffffffff"/>
            </TimeText>

            <!-- Ambient Time Display -->
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="400" height="75" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255"/>
                <Font family="jetbrains_mono_bold" size="62" weight="NORMAL" color="#ffc0caf5"/>
            </TimeText>
        </DigitalClock>

        <!-- Date (Interactive Mode, clean without slogan) -->
        <PartText x="25" y="302" width="400" height="28" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="jetbrains_mono_bold" size="17" weight="NORMAL" color="#ff7aa2f7">
                    <Template><![CDATA[%s %d %s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[DAY]"/>
                        <Parameter expression="[MONTH_S]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Date in Ambient Mode -->
        <PartText x="25" y="302" width="400" height="28" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="200"/>
            <Text align="CENTER">
                <Font family="jetbrains_mono_bold" size="17" weight="NORMAL" color="#ff565f89">
                    <Template><![CDATA[%s %d %s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[DAY]"/>
                        <Parameter expression="[MONTH_S]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- RADIAL COMPLICATION 1: TOP-RIGHT (Battery) -->
        <ComplicationSlot
            slotId="1"
            isCustomizable="TRUE"
            displayName="@string/battery_complication_label"
            supportedTypes="RANGED_VALUE SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY"
            x="0" y="0" width="450" height="450">
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE"/>
            <BoundingArc
                centerX="225" centerY="225"
                width="416" height="416"
                thickness="44"
                isRoundEdge="TRUE"
                startAngle="16" endAngle="76"
                direction="CLOCKWISE"
                outlinePadding="2"/>
            <Complication type="RANGED_VALUE">
                <!-- Dynamic Gauge Track -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc direction="CLOCKWISE" startAngle="16" endAngle="76" centerX="225" centerY="225" width="416" height="416">
                        <Transform target="endAngle" value="16 + (((clamp(([COMPLICATION.RANGED_VALUE_VALUE]), ([COMPLICATION.RANGED_VALUE_MIN]), ([COMPLICATION.RANGED_VALUE_MAX])) - ([COMPLICATION.RANGED_VALUE_MIN])) / (([COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN]) ? 100 : ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]))) * 60)"/>
                        <Stroke color="#ff9ece6a" cap="ROUND" thickness="10"/>
                    </Arc>
                </PartDraw>
                <!-- Curved Text along Arc -->
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="356" height="356" startAngle="16" endAngle="76" direction="CLOCKWISE" align="CENTER" ellipsis="TRUE">
                        <Font family="jetbrains_mono_bold" size="25" weight="BOLD" color="#ff9ece6a">
                            <Template><![CDATA[⚡ %s%%]]>
                                <Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])"/>
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc direction="CLOCKWISE" startAngle="16" endAngle="76" centerX="225" centerY="225" width="416" height="416">
                        <Transform target="endAngle" value="16 + (clamp([BATTERY_PERCENT], 0, 100) / 100.0) * 60"/>
                        <Stroke color="#ff9ece6a" cap="ROUND" thickness="10"/>
                    </Arc>
                </PartDraw>
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="356" height="356" startAngle="16" endAngle="76" direction="CLOCKWISE" align="CENTER" ellipsis="TRUE">
                        <Font family="jetbrains_mono_bold" size="25" weight="BOLD" color="#ff9ece6a">
                            <Template><![CDATA[⚡ %s]]>
                                <Parameter expression="[COMPLICATION.TEXT] != null ? [COMPLICATION.TEXT] : ([BATTERY_PERCENT] + %)"/>
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="338" y="84" width="28" height="28">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="338" y="84" width="28" height="28">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- RADIAL COMPLICATION 2: BOTTOM-RIGHT (Steps) -->
        <ComplicationSlot
            slotId="2"
            isCustomizable="TRUE"
            displayName="@string/steps_complication_label"
            supportedTypes="RANGED_VALUE SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY"
            x="0" y="0" width="450" height="450">
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingArc
                centerX="225" centerY="225"
                width="416" height="416"
                thickness="44"
                isRoundEdge="TRUE"
                startAngle="104" endAngle="164"
                direction="CLOCKWISE"
                outlinePadding="2"/>
            <Complication type="RANGED_VALUE">
                <!-- Dynamic Gauge Track -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc direction="CLOCKWISE" startAngle="104" endAngle="164" centerX="225" centerY="225" width="416" height="416">
                        <Transform target="endAngle" value="104 + (((clamp(([COMPLICATION.RANGED_VALUE_VALUE]), ([COMPLICATION.RANGED_VALUE_MIN]), ([COMPLICATION.RANGED_VALUE_MAX])) - ([COMPLICATION.RANGED_VALUE_MIN])) / (([COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN]) ? 10000 : ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]))) * 60)"/>
                        <Stroke color="#ffe0af68" cap="ROUND" thickness="10"/>
                    </Arc>
                </PartDraw>
                <!-- Curved Text along Arc -->
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="356" height="356" startAngle="164" endAngle="104" direction="COUNTER_CLOCKWISE" align="CENTER" ellipsis="TRUE">
                        <Font family="jetbrains_mono_bold" size="24" weight="BOLD" color="#ffe0af68">
                            <Template><![CDATA[👟 %s]]>
                                <Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])"/>
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <!-- Steps Gauge Track -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc direction="CLOCKWISE" startAngle="104" endAngle="164" centerX="225" centerY="225" width="416" height="416">
                        <Transform target="endAngle" value="104 + (clamp([STEP_COUNT], 100, 10000) / 10000.0) * 60"/>
                        <Stroke color="#ffe0af68" cap="ROUND" thickness="10"/>
                    </Arc>
                </PartDraw>
                <!-- Curved Text along Arc -->
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="356" height="356" startAngle="164" endAngle="104" direction="COUNTER_CLOCKWISE" align="CENTER" ellipsis="TRUE">
                        <Font family="jetbrains_mono_bold" size="24" weight="BOLD" color="#ffe0af68">
                            <Template><![CDATA[👟 %s]]>
                                <Parameter expression="[COMPLICATION.TEXT] != null ? [COMPLICATION.TEXT] : [STEP_COUNT]"/>
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="338" y="338" width="28" height="28">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="338" y="338" width="28" height="28">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- RADIAL COMPLICATION 3: BOTTOM-LEFT (Heart Rate / Health / Notification) -->
        <ComplicationSlot
            slotId="3"
            isCustomizable="TRUE"
            displayName="@string/heart_rate_complication_label"
            supportedTypes="RANGED_VALUE SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY"
            x="0" y="0" width="450" height="450">
            <DefaultProviderPolicy
                defaultSystemProvider="UNREAD_NOTIFICATION_COUNT"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingArc
                centerX="225" centerY="225"
                width="416" height="416"
                thickness="44"
                isRoundEdge="TRUE"
                startAngle="196" endAngle="256"
                direction="CLOCKWISE"
                outlinePadding="2"/>
            <Complication type="RANGED_VALUE">
                <!-- Dynamic Gauge Track -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc direction="CLOCKWISE" startAngle="196" endAngle="256" centerX="225" centerY="225" width="416" height="416">
                        <Transform target="endAngle" value="196 + (((clamp(([COMPLICATION.RANGED_VALUE_VALUE]), ([COMPLICATION.RANGED_VALUE_MIN]), ([COMPLICATION.RANGED_VALUE_MAX])) - ([COMPLICATION.RANGED_VALUE_MIN])) / (([COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN]) ? 150 : ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]))) * 60)"/>
                        <Stroke color="#fff7768e" cap="ROUND" thickness="10"/>
                    </Arc>
                </PartDraw>
                <!-- Curved Text along Arc -->
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="356" height="356" startAngle="256" endAngle="196" direction="COUNTER_CLOCKWISE" align="CENTER" ellipsis="TRUE">
                        <Font family="jetbrains_mono_bold" size="24" weight="BOLD" color="#fff7768e">
                            <Template><![CDATA[❤️ %s]]>
                                <Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])"/>
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <!-- Dynamic Track -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc direction="CLOCKWISE" startAngle="196" endAngle="256" centerX="225" centerY="225" width="416" height="416">
                        <Stroke color="#fff7768e" cap="ROUND" thickness="10"/>
                    </Arc>
                </PartDraw>
                <!-- Curved Text along Arc -->
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="356" height="356" startAngle="256" endAngle="196" direction="COUNTER_CLOCKWISE" align="CENTER" ellipsis="TRUE">
                        <Font family="jetbrains_mono_bold" size="24" weight="BOLD" color="#fff7768e">
                            <Template><![CDATA[❤️ %s]]>
                                <Parameter expression="[COMPLICATION.TEXT] != null ? [COMPLICATION.TEXT] : ([HEART_RATE] &gt; 0 ? [HEART_RATE] : --)"/>
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="84" y="338" width="28" height="28">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="84" y="338" width="28" height="28">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- RADIAL COMPLICATION 4: TOP-LEFT (Weather / Day / Calendar) -->
        <ComplicationSlot
            slotId="4"
            isCustomizable="TRUE"
            displayName="@string/weather_complication_label"
            supportedTypes="RANGED_VALUE SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY"
            x="0" y="0" width="450" height="450">
            <DefaultProviderPolicy
                defaultSystemProvider="DAY_OF_WEEK"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingArc
                centerX="225" centerY="225"
                width="416" height="416"
                thickness="44"
                isRoundEdge="TRUE"
                startAngle="284" endAngle="344"
                direction="CLOCKWISE"
                outlinePadding="2"/>
            <Complication type="RANGED_VALUE">
                <!-- Dynamic Gauge Track -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc direction="CLOCKWISE" startAngle="284" endAngle="344" centerX="225" centerY="225" width="416" height="416">
                        <Transform target="endAngle" value="284 + (((clamp(([COMPLICATION.RANGED_VALUE_VALUE]), ([COMPLICATION.RANGED_VALUE_MIN]), ([COMPLICATION.RANGED_VALUE_MAX])) - ([COMPLICATION.RANGED_VALUE_MIN])) / (([COMPLICATION.RANGED_VALUE_MAX] == [COMPLICATION.RANGED_VALUE_MIN]) ? 100 : ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]))) * 60)"/>
                        <Stroke color="#ff7dcfff" cap="ROUND" thickness="10"/>
                    </Arc>
                </PartDraw>
                <!-- Curved Text along Arc -->
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="356" height="356" startAngle="284" endAngle="344" direction="CLOCKWISE" align="CENTER" ellipsis="TRUE">
                        <Font family="jetbrains_mono_bold" size="24" weight="BOLD" color="#ff7dcfff">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT] != null ? [COMPLICATION.TEXT] : round([COMPLICATION.RANGED_VALUE_VALUE])"/>
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <!-- Track -->
                <PartDraw x="0" y="0" width="450" height="450">
                    <Arc direction="CLOCKWISE" startAngle="284" endAngle="344" centerX="225" centerY="225" width="416" height="416">
                        <Stroke color="#ff7dcfff" cap="ROUND" thickness="10"/>
                    </Arc>
                </PartDraw>
                <!-- Curved Text along Arc -->
                <PartText x="0" y="0" width="450" height="450">
                    <TextCircular centerX="225" centerY="225" width="356" height="356" startAngle="284" endAngle="344" direction="CLOCKWISE" align="CENTER" ellipsis="TRUE">
                        <Font family="jetbrains_mono_bold" size="24" weight="BOLD" color="#ff7dcfff">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT] != null ? [COMPLICATION.TEXT] : [DAY_OF_WEEK_S]"/>
                            </Template>
                        </Font>
                    </TextCircular>
                </PartText>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="84" y="84" width="28" height="28">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="84" y="84" width="28" height="28">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>
    </Scene>
</WatchFace>