<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <Scene backgroundColor="#ff000000">
        <!-- Background Accent Rings -->
        <Group x="0" y="0" width="450" height="450" name="accents" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <PartDraw x="0" y="0" width="450" height="450">
                <Ellipse x="25" y="25" width="400" height="400">
                    <Stroke thickness="1" color="#ff24283b"/>
                </Ellipse>
                <Ellipse x="55" y="55" width="340" height="340">
                    <Stroke thickness="1" color="#ff1f2335"/>
                </Ellipse>
            </PartDraw>
        </Group>

        <!-- Omarchy Green Arch Icon -->
        <PartImage x="197" y="98" width="56" height="56" alpha="255">
            <Image resource="ic_omarchy_icon"/>
            <Variant mode="AMBIENT" target="alpha" value="70"/>
        </PartImage>

        <!-- Official Omarchy Pixel Art Wordmark -->
        <PartImage x="135" y="165" width="180" height="42" alpha="255">
            <Image resource="ic_omarchy_logo_white"/>
            <Variant mode="AMBIENT" target="alpha" value="120"/>
        </PartImage>

        <!-- Digital Clock (Interactive Mode) -->
        <DigitalClock x="25" y="215" width="400" height="75">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="400" height="75" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <Font family="jetbrains_mono_bold" size="62" weight="BOLD" color="#ffffffff"/>
            </TimeText>

            <!-- Ambient Time Display -->
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="400" height="75" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255"/>
                <Font family="jetbrains_mono_bold" size="62" weight="NORMAL" color="#ffc0caf5"/>
            </TimeText>
        </DigitalClock>

        <!-- Date & Slogan (Interactive Mode) -->
        <PartText x="25" y="294" width="400" height="28" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="jetbrains_mono_bold" size="13" weight="NORMAL" color="#ff7aa2f7">
                    <Template><![CDATA[%s %d %s  •  BE THE OMARCH]]>
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[DAY]"/>
                        <Parameter expression="[MONTH_S]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Date in Ambient Mode -->
        <PartText x="25" y="294" width="400" height="28" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="200"/>
            <Text align="CENTER">
                <Font family="jetbrains_mono_bold" size="13" weight="NORMAL" color="#ff565f89">
                    <Template><![CDATA[%s %d %s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[DAY]"/>
                        <Parameter expression="[MONTH_S]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- TOP COMPLICATION: Battery (Slot 1) -->
        <ComplicationSlot
            slotId="1"
            displayName="@string/battery_complication_label"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY"
            x="165" y="32" width="120" height="56">
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE"/>
            <BoundingOval x="0" y="0" width="120" height="56" outlinePadding="2.0"/>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="28" width="120" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#ff9ece6a">
                            <Template><![CDATA[⚡ %s%%]]>
                                <Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="16" width="120" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#ff9ece6a">
                            <Template><![CDATA[⚡ %s]]>
                                <Parameter expression="[COMPLICATION.TEXT]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- BOTTOM COMPLICATION: Steps / Activity (Slot 2) -->
        <ComplicationSlot
            slotId="2"
            displayName="@string/steps_complication_label"
            supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="165" y="362" width="120" height="56">
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingOval x="0" y="0" width="120" height="56" outlinePadding="2.0"/>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="16" width="120" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#ffe0af68">
                            <Template><![CDATA[👟 %s STEPS]]>
                                <Parameter expression="[COMPLICATION.TEXT]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="16" width="120" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#ffe0af68">
                            <Template><![CDATA[👟 %s]]>
                                <Parameter expression="round([COMPLICATION.RANGED_VALUE_VALUE])"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- LEFT COMPLICATION: Heart Rate / Health (Slot 3) -->
        <ComplicationSlot
            slotId="3"
            displayName="@string/heart_rate_complication_label"
            supportedTypes="SHORT_TEXT SMALL_IMAGE EMPTY"
            x="20" y="196" width="90" height="56">
            <BoundingOval x="0" y="0" width="90" height="56" outlinePadding="2.0"/>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="16" width="90" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#fff7768e">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT] != null && [COMPLICATION.TEXT] != 'None' ? ('♥ ' + [COMPLICATION.TEXT]) : ''"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="25" y="8" width="40" height="40">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>

        <!-- RIGHT COMPLICATION: Weather / Next Event (Slot 4) -->
        <ComplicationSlot
            slotId="4"
            displayName="@string/weather_complication_label"
            supportedTypes="SHORT_TEXT SMALL_IMAGE EMPTY"
            x="340" y="196" width="90" height="56">
            <BoundingOval x="0" y="0" width="90" height="56" outlinePadding="2.0"/>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="16" width="90" height="24">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#ff7dcfff">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT] != null && [COMPLICATION.TEXT] != 'None' ? [COMPLICATION.TEXT] : ''"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="25" y="8" width="40" height="40">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
            <Complication type="EMPTY"/>
        </ComplicationSlot>
    </Scene>
</WatchFace>
